# Required
BOT_TOKEN=
# Comma-separated Telegram user IDs with access to /admin
ADMIN_IDS=

# Picked up from getMe when empty; used for the preview watermark
BOT_USERNAME=

# Shown on the "Information" screen
SUPPORT_USERNAME=
PRIVACY_URL=
TERMS_URL=

# Pack editor mini-app. Telegram requires a public HTTPS URL; the server
# listens on WEBAPP_HOST:WEBAPP_PORT behind a reverse proxy.
WEBAPP_URL=
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# Payments (each provider is disabled while its credentials are empty)
PLATEGA_MERCHANT_ID=
PLATEGA_TOKEN=
SBP_MIN_AMOUNT=10
CRYPTOBOT_TOKEN=
CRYPTOBOT_TESTNET=false
YOOMONEY_QUICKPAY_URL=
YOOMONEY_MIN_AMOUNT=10
STARS_RATE=1

# Billing defaults; values saved from the admin panel take precedence
RENDER_PRICE=10
FREE_RENDERS=0
STARTER_BALANCE_RUB=30

# Rendering
OUTPUT_FORMAT=mp4
OUTPUT_WIDTH=1920
OUTPUT_HEIGHT=530
OUTPUT_FPS=60
STICKER_SCALE=0.85
SUPERSAMPLE=2.0
MAX_RENDER_SECONDS=6.0
MATTE_COLOR=000000
H264_CRF=23
H264_PRESET=slow
H264_MAX_KBPS=2000
GIF_QUALITY=100
USE_GIFSKI=true

# Limits
WORKERS=
MAX_TGS_SIZE_MB=5
MAX_BG_SIZE_MB=30
